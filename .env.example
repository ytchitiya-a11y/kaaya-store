# Copy this file to .env.local for local development,
# or set these as Environment Variables in your Vercel project settings.

# ---- Database (Postgres) ----
# Get this free from https://neon.tech (or Vercel Postgres, which uses Neon).
# Local testing example: postgresql://postgres:postgres@localhost:5432/kaaya
DATABASE_URL=postgresql://neondb_owner:npg_i7mUlGsZhYB5@ep-noisy-bird-b32niprp-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Cloudinary (image/video hosting) ----
# Get these free from https://cloudinary.com/console (Dashboard tab).
# Either set CLOUDINARY_URL (one line, shown on your dashboard) ...
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# ... or set these three separately instead:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Admin login ----
# Used to sign admin login sessions. Set this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Used only by `npm run seed` to create the very first admin account.
SEED_ADMIN_USER=admin
SEED_ADMIN_EMAIL=admin@kaaya.com
SEED_ADMIN_PASS=admin123
